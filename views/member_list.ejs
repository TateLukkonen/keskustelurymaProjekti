<div class="member-list-content">

    <% data.forEach(member=> { %>

        <a href="/profile/<%= member.user_id %>">

            <div class="member">

                <div class="img-wrap">
                    <img class="pfp" src="<%= member.pfp || '/uploads/default_icon.png' %>" alt="<%= member.name %>">
                </div>

                <div class="info">

                    <div class="name">
                        <%= member.name %>
                    </div>

                    <div class="bio">
                        <%= member.bio ? member.bio.slice(0, 20) + "..." : "No bio yet" %>
                    </div>

                </div>

            </div>

        </a>

        <% }) %>

</div>