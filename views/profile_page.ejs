<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>

    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/basic.css">
</head>

<body>

    <%- include('header') %>

    <div class="container">

        <section class="top-section">

            <div class="left-info">
                <h2><%= user.username %></h2>

                <p class="display-name">
                    Display name: <%= user.display_name %>
                </p>

                <div class="status">
                    <span>Status:</span>
                    <span class="<%= user.status %>"></span>
                </div>
            </div>

            <div class="profile-center">

                <h2><%= user.display_name %></h2>

                <h4><%= user.username %></h4>

                <div class="profile-pic">
                    <img src="<%= user.avatar_url || '/uploads/default_icon.png' %>" alt="PFP">
                </div>

            </div>

            <div class="bio">
                <h3>Bio</h3>
                <p><%= user.bio || "No bio yet..." %></p>
            </div>

        </section>

        <section class="bottom-section">

            <div class="server-toggle">
                <button>Joined servers</button>
            </div>

            <div class="servers">
                <% servers.forEach(server => { %>
                    <div class="<%= server.is_private ? 'private' : 'public' %>">
                        <%- include('server_card', { server }) %>
                    </div>
                <% }) %>
            </div>

        </section>

    </div>

</body>
</html>