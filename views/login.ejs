<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LOGIN</title>
    <link rel="shortcut icon" href="/uploads/kaverilounge_favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/styles/basic.css">
    <link rel="stylesheet" href="/styles/login.css">
</head>

<body>
    <%- include("header") %>

        <main class="login-page">
            <section class="login-card">

                <h1>Login</h1>
                <p class="login-subtitle">Welcome back to VΣLCHAT</p>

                <form action="/login" method="post" class="login-form">
                    <input type="text" name="login" id="login" placeholder="Username or email" required>

                    <input type="password" name="password" id="password" placeholder="Password" required>

                    <button type="submit">Login</button>
                </form>

                <p class="register-text">
                    Don't have an account?
                    <a href="/register">Register</a>
                </p>

            </section>
        </main>
</body>

</html>