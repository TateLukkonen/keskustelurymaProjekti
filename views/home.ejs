<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/basic.css">
</head>

<body>

    <%- include('header') %>

    <div class="container">

        <section class="top-section">

            <div class="left-info">
                <h2><%= user.username %></h2>

                <p class="display-name">
                    Display name: <%= user.display_name %>
                </p>

                <form action="/update_display_name" method="POST">
                    <input 
                        type="text" 
                        name="display_name" 
                        placeholder="Edit display name"
                    >
                    <button type="submit">Save changes</button>
                </form>

                <div class="status">
                    <span>Status:</span>
                    <span class="<%= user.status %>"></span>
                </div>
            </div>

            <div class="profile-center">

                <h2><%= user.username %></h2>

                <div class="profile-pic">
                    <img 
                        src="<%= user.avatar_url || '/uploads/default_icon.png' %>" 
                        alt="PFP"
                    >
                </div>

            </div>

            <div class="bio">
    <h3>Bio</h3>

    <p><%= user.bio || "No bio yet..." %></p>

    <form action="/update_bio" method="POST">
        <textarea
            name="bio"
            placeholder="Write your bio here..."
            rows="4"
        ><%= user.bio || "" %></textarea>

        <button type="submit">Save Bio</button>
    </form>
</div>

        </section>

        <section class="bottom-section">

            <div class="create-server">
                <a href="/create_server_settings" class="create-server-btn">
                    + Create Server
                </a>
            </div>

            <div class="server-toggle">
                <button onclick="showPublic()">Public server</button>
                <button onclick="showPrivate()">Private server</button>
            </div>

            <div class="servers">
                <% servers.forEach(server => { %>
                    <div class="<%= server.is_private ? 'private' : 'public' %>">
                        <%- include('server_card', { server }) %>
                    </div>
                <% }) %>
            </div>

        </section>

    </div>

</body>
</html>