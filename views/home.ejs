<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>
<body>
    <header> </header>

<div class="container">

   
    <div class="top-section">

        <div class="left-info">
            <h2><%= user.username %></h2>
            <p>Display name: <%= user.displayName %></p>

            <form action="/update-profile" method="POST">
                <input type="text" name="displayName" placeholder="Edit display name">
                <button type="submit">Save changes</button>
            </form>

            <div class="status">
                <span>Status:</span>
                <span class="<%= user.online ? 'online' : 'offline' %>"></span>
            </div>
        </div>

        
        <div class="profile-pic">
            <img src="<%= user.pfp || '/default.png' %>" alt="PFP">
        </div>

        
        <div class="bio">
            <h3>Bio</h3>
            <p><%= user.bio || "No bio yet..." %></p>
        </div>

    </div>

    
    <div class="server-toggle">
        <button onclick="showPublic()">Public server</button>
        <button onclick="showPrivate()">Private server</button>
    </div>

    
    <div class="servers">

        <% servers.forEach(server => { %>
            <div class="server-card">
                <div class="icon"></div>
                <div class="info">
                    <p><%= server.name %></p>
                    <small>
                        Members: <%= server.members %><br>
                        Created: <%= server.createdAt.toDateString() %>
                    </small>
                </div>
            </div>
        <% }) %>

    </div>

</div>

<script>
function showPublic() {
    
    console.log("Public servers");
}

function showPrivate() {
    console.log("Private servers");
}
</script>

</body>
</html>