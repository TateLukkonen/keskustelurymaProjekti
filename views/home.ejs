<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>
<body>

<header class="top-bar"></header>

<div class="container">

    
    <section class="top-section">

        

        <div class="left-info">
    <h2><%= user.username %></h2>

    <p class="display-name">Display name: <%= user.displayName %></p>

    <form action="/update-profile" method="POST" class="edit-form">
        <input type="text" name="displayName" placeholder="Edit display name">
        <button type="submit">Save changes</button>
    </form>

    <div class="status">
        <span>Status:</span>
        <span class="<%= user.online ? 'online' : 'offline' %>"></span>
    </div>
</div>

    
        <div class="profile-center">
            <h2><%= user.username %></h2>

            <div class="profile-pic">
                <img src="<%= user.pfp || '/uploads/default_icon.png' %>" alt="PFP">
            </div>
        </div>

        <div class="bio">
                <h3>Bio</h3>
                <p><%= user.bio || "No bio yet..." %></p>
        </div>

    </section>
    
    

    
    <section class="bottom-section">

        <div class="server-toggle">
            <button onclick="showPublic()">Public server</button>
            <button onclick="showPrivate()">Private server</button>
        </div>

        <div class="servers">
            <% servers.forEach(server => { %>
                <%- include('server_card', { server }) %>
            <% }) %>
        </div>

    </section>

</div>

</body>
</html>