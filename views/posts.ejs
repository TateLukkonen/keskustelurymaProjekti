<div class="posts-container">
    <% posts.forEach(post => { %>
        <div class="post-card" id="<%= post.post_id %>">
            <div class="post-header">
                <div class="post-content-body">
                    <h3 class="post-title">
                        <%= post.title || 'Post Title' %>
                    </h3>

                    <p class="post-message">
                        <%= post.text_message || 'Post Message.' %>
                    </p>

                    <% if (post.post_image) { %>
                        <img 
                            src="<%= post.img %>" 
                            class="post-image" 
                            alt="Post image"
                        >
                    <% } %>
                </div>

                <div class="user-info">
                    <span class="username">
                        <%= post.display_name || 'User' %>
                    </span>

                    <div class="user-avatar-container">
                        <% if (post.avatar_url) { %>
                            <img 
                                src="<%= post.avatar_url %>" 
                                class="user-avatar-img"
                                alt="Avatar"
                                onerror="this.style.display='none'"
                            >
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="post-footer">
                <div class="comments-trigger">
                    Click to see comments...
                </div>
                <div class="vote-arrows">

                    <button type="button" class="vote-button upvote">
                        <div class="arrow-up"></div>
                    </button>

                    <div class="score">
                        <%= post.upvotes - post.downvotes %>
                    </div>

                    <button type="button" class="vote-button downvote">
                        <div class="arrow-down"></div>
                    </button>

                </div>
            </div>
        </div>
    <% }) %>
</div>