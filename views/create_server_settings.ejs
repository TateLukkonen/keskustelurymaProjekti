<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/create_server" id="serverForm" method="POST" enctype="multipart/form-data">
        <input type="text" name="server_name" placeholder="Server name" required>
        <input type="text" name="short_name" placeholder="Display name" rquired>
        <div class="pfp-group">
            <label>PICTURE (Max 512KB)</label>
            <div class="image-frame">
                <img id="preview" src="#" alt="Preview" />
                <span id="placeholder">No Image</span>
            </div>
            <input
                type="file"
                id="pfp_input"
                name="pfp"
                accept="image/*"
            />
        </div>
        <input type="radio" name="pub_priv" value="public_choice"> Public
        <input type="radio" name="pub_priv" value="private_choice"> Private
        <button type="submit">Create Server</button>
    </form>
</body>
</html>