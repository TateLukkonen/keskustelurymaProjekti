<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= serverName || "Posts" %>
    </title>

    <link rel="stylesheet" href="/styles/posts.css">
    <link rel="stylesheet" href="/styles/basic.css">
    <link rel="stylesheet" href="/styles/channel.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@200..1000&display=swap" rel="stylesheet">
</head>

<body>
    <%- include("header") %>

        <div class="content">
            <div class="top-section">
                <div class="top-left">
                    <a href="/home">HOME ICON</a>
                </div>

                <% if (!joined) { %>
                    <form method="post" action="/join_server">
                        <input type="hidden" name="server_id" value="<%= serverId %>">
                        <button>Join Server</button>
                    </form>

                    <p>You must join to post.</p>
                    <% } else { %>
                        <p>You are a member ✔</p>
                        <% } %>

                            <div class="directory">
                                <p>| <a href="/home">home</a> > <%= serverName || "Server Name" %> > Posts |</p>
                            </div>

                            <div class="profile-settings">
                                <%- include("small_profile", { user: { icon: sessionUser.avatar_url, name:
                                    sessionUser.display_name, status: sessionUser.status } }) %>

                                    <a href="/user_settings">SETTINGS ICON</a>
                            </div>
            </div>

            <div class="bottom-section">
                <%- include("server_list", { data: [ { name: "SERVER" }, { name: "SLIME" }, { name: "TERRA" }, {
                    name: "VELCHAT" }, { name: "LUNYX" } ] }) %>

                    <section class="posts-area">

                        <section class="posts">
                            <% posts.forEach(post=> { %>
                                <article class="post">

                                    <div class="post-top">
                                        <div>
                                            <h2>
                                                <%= post.title %>
                                            </h2>

                                            <p>
                                                <%= post.text_content || "" %>
                                            </p>
                                        </div>

                                        <div class="post-user">
                                            <span>
                                                <%= post.display_name || post.username %>
                                            </span>

                                            <img class="avatar"
                                                src="<%= post.avatar_url || '/uploads/default_icon.png' %>" alt="">
                                        </div>
                                    </div>

                                    <% if (post.img) { %>
                                        <img class="post-image" src="<%= post.img %>" alt="Post image">
                                        <% } %>

                                            <div class="actions">
                                                <form method="post" action="/posts/<%= post.post_id %>/upvote"
                                                    class="inline">
                                                    <button class="vote up">▲ <%= post.upvotes || 0 %></button>
                                                </form>

                                                <form method="post" action="/posts/<%= post.post_id %>/downvote"
                                                    class="inline">
                                                    <button class="vote down">▼ <%= post.downvotes || 0 %></button>
                                                </form>
                                            </div>

                                            <div class="comments">
                                                <% comments .filter(comment=> comment.post_id === post.post_id)
                                                    .forEach(comment => { %>

                                                    <div class="comment">
                                                        <p>
                                                            <strong>
                                                                <%= comment.display_name || comment.username %>:
                                                            </strong>
                                                            <%= comment.text_content %>
                                                        </p>
                                                    </div>

                                                    <% }) %>

                                                        <% if (joined) { %>
                                                            <form method="post"
                                                                action="/posts/<%= post.post_id %>/comments"
                                                                class="comment-form">
                                                                <input name="text_content"
                                                                    placeholder="Write a comment..." required>
                                                                <button>Comment</button>
                                                            </form>
                                                            <% } %>
                                            </div>

        <div class="bottom-section"> <!-- 3 divs -->
            <%- include('server_list', { data: [{ name: 'SERVER' }, { name: 'SLIME' }, { name: 'TERRA' }, { name: 'VELCHAT' }, { name: 'LUNYX' }] }) %> <!-- server/dm list, def an ejs -->

             <%- include('posts', {
    posts: [
        {
            title: 'First Post',
            message: 'Hello world',
            display_name: 'Mikko',
            avatar_url: '/uploads/default_icon.png',
            post_image: '/uploads/default_post.png'
        },

        {
            title: 'Second Post',
            message: 'Another message',
            display_name: 'Anna',
            avatar_url: '/uploads/default_icon.png',
            post_image: ''
        }
    ]
}) %>

            <%- include('member_list', { data: [{ user_id: 1, name: 'MEMBER', pfp: '/uploads/default_icon.png', status: 'online', bio: 'this is my bio description'}]}) %> <!-- shows all members in the channel, probs ejs  -->
        </div>

        <script>
            function openPostModal() {
                document.getElementById("postModal").style.display = "flex";
            }

            function closePostModal() {
                document.getElementById("postModal").style.display = "none";
            }

            window.addEventListener("click", (e) => {
                const modal = document.getElementById("postModal");

                if (e.target === modal) {
                    modal.style.display = "none";
                }
            });
        </script>
</body>
</html>