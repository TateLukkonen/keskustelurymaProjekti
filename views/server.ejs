<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link el rel="stylesheet" href="/styles/posts.css">
    <link rel="stylesheet" href="/styles/basic.css">
    <link rel="stylesheet" href="/styles/channel.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('header') %>

    <div class="content">
        <div class="top-section"> <!-- this has home, server/dm switch, directory, profile and settings -->
            <div class="top-left">
                <a href="/home">HOME ICON</a>
            </div>

            <% if (!joined) { %>
                <form method="POST" action="/join_server">
                    <input type="hidden" name="server_id" value="<%= serverId %>">
                    <button>Join Server</button>
                </form>
          
                <p>You must join to send messages.</p>
          
            <% } else { %>
                <p>You are a member ✔</p>
            <% } %>

            <div class="directory"> <!-- example: | home > servers > Server Name > Channel Name | -->
                <p>| <a href="/home">home</a> > Server Name > Channel Name |</p>
            </div>
            

            <div class="profile-settings">
                <%- include('small_profile', { user: { icon: sessionUser.avatar_url, name: sessionUser.display_name, status: sessionUser.status }}) %>
                <a href="/user_settings">SETTINGS ICON</a> <!-- links nowhere rn -->
            </div>

        </div> 

        <div class="bottom-section"> <!-- 3 divs -->
            <%- include('server_list', { data: joinedServers }) %> <!-- server/dm list, def an ejs -->

             <%- include('posts', { posts: posts }) %>

            <%- include('member_list', { data: memberList}) %> <!-- shows all members in the channel, probs ejs  -->
        </div>
    </div>
</body>
<script src="/socket.io/socket.io.js"></script>
<script>
    let socket = io()

    const serverId = '<%= serverId %>'

    socket.emit('join_server_room', serverId)

    document.addEventListener('click', (e) => {
        if (e.target.closest('.upvote')) {
            const postCard = e.target.closest('.post-card')

            socket.emit('upvote', postCard.id, serverId)
        }
        else if (e.target.closest('.downvote')) {
            const postCard = e.target.closest('.post-card')

            socket.emit('downvote', postCard.id, serverId)
        }

    })

    socket.on('post upvote', function(post_id) {
        let post = document.getElementById(post_id)

        post.querySelector('.score').textContent = Number(post.querySelector('.score').textContent) + 1
    })

    socket.on('post downvote', function(post_id) {
        let post = document.getElementById(post_id)

        post.querySelector('.score').textContent = Number(post.querySelector('.score').textContent) - 1
    })
</script>
</html>