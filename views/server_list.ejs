<div class="list">
    <% for (server of data) { %>
        <a href="/server/<%= server.server_id %>">
            <div class="convo">
                    <img src="<%= server.server_picture_url || '/uploads/default_icon.png' %>" alt="<%= server.name %>">
                <div class="name">
                    <p>
                        <%= server.short_name %>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>